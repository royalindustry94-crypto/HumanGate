# Copy to .env and fill in real values. Never commit .env.
# Required vars have no default in code — the app will refuse to start
# without them rather than silently falling back to something unsafe.

# --- Shared ---
ENVIRONMENT=development
# OpenAPI /docs /redoc are enabled only when ENVIRONMENT is development|dev (P-005).
LOG_LEVEL=INFO
# Reserved for future multi-mode auth switches (supabase | …).
# Today the API always verifies Supabase JWTs via SUPABASE_JWT_SECRET.
# AUTH_MODE=supabase

# --- Database (api + worker) ---
# DATABASE_URL: owner/migration connection (Alembic runs as this).
# Local docker-compose.yml only. ENVIRONMENT=development|dev|test may use
# these documented local defaults. Staging/production must use rotated
# owner and runtime secrets — the API refuses known defaults there (P0-2).
# Staging compose (docker-compose.staging.yml) requires:
#   POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB
#   APP_RUNTIME_USER, APP_RUNTIME_PASSWORD
# If those defaults were ever deployed, rotate both roles and inspect
# Postgres/host access logs for unexpected 5432 connections.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/content_orchestrator

# APP_DATABASE_URL: runtime connection, used for every request. Connects
# as the non-owner `app_runtime` role so Row Level Security actually
# applies. See docs/milestone-2-identity-and-access.md §6.
# Local dev via docker-compose: postgresql://app_runtime:app_runtime@localhost:5432/content_orchestrator
APP_DATABASE_URL=postgresql://app_runtime:app_runtime@localhost:5432/content_orchestrator

# Staging compose required secrets (no defaults; never commit real values):
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=content_orchestrator
# APP_RUNTIME_USER=app_runtime
# APP_RUNTIME_PASSWORD=

# --- Supabase Auth ---
# Project Settings > API > JWT Settings > JWT Secret
# Use a secret >= 32 bytes. Private Beta without Supabase Auth:
AUTH_MODE=local

# Local-only preview credentials. Required by scripts/run_ops_preview*.sh; do not commit real values.
OPS_PREVIEW_EMAIL=
OPS_PREVIEW_PASSWORD=
# Production default in code is AUTH_MODE=supabase (fail-closed).
# ALLOW_LOCAL_AUTH_IN_PRODUCTION=false
# P0-1 (2026-09-13 audit): required to be >= 32 bytes and not a known
# placeholder/default/repository-test value in every environment except
# ENVIRONMENT=test (see app/core/config.py's _validate_jwt_secret) —
# generate one with `openssl rand -base64 32`. Never reuse this file's
# blank value or the committed test fixture
# `test-supabase-jwt-secret-0123456789abcdef`.
# If a weak secret has ever been deployed, treat it as compromised and
# rotate it (re-issue SUPABASE_JWT_SECRET) rather than just tightening
# validation going forward.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated
# Required when AUTH_MODE=supabase outside ENVIRONMENT=test. Use the
# managed project issuer (https://<project-ref>.supabase.co/auth/v1).
# AUTH_MODE=local defaults to `content-orchestrator-local` and verifies
# that exact `iss` on every accepted token. Follow-up (not yet
# implemented): verify via Supabase's JWKS endpoint instead of a shared
# HMAC secret, which removes this whole class of weak-secret risk.
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# --- CORS ---
# Dev (Vite): http://localhost:5173
# Staging compose web (nginx): http://localhost:8080
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- Spend caps (global defaults; per-workspace overrides stored in DB later) ---
DEFAULT_DAILY_SPEND_CAP_USD=50.0
DEFAULT_MONTHLY_SPEND_CAP_USD=1000.0

# --- Rate limiting (P1-010 / TD-034; optional overrides, in-process per-IP) ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_REQUESTS_PER_WINDOW=300
# AUTH_RATE_LIMIT_REQUESTS_PER_WINDOW=10

# --- API scheduler / orchestration intervals (optional overrides) ---
# OUTBOX_RELAY_INTERVAL_SECONDS=2
# ASSIGNMENT_REAPER_INTERVAL_SECONDS=15
# ASSIGNMENT_LEASE_SECONDS=60
# ASSIGNMENT_MAX_LEASE_SECONDS=900
# WORKER_SUSPECT_AFTER_SECONDS=30
# WORKER_OFFLINE_AFTER_SECONDS=90
# WORKER_OFFLINE_SWEEP_INTERVAL_SECONDS=30
# BACKPRESSURE_EVAL_INTERVAL_SECONDS=15

# --- Worker ---
HEALTH_CHECK_INTERVAL_SECONDS=300
# API_BASE_URL=http://127.0.0.1:8000
# Staging compose sets API_BASE_URL=http://api:8000
# HEARTBEAT_INTERVAL_SECONDS=10
# WORKER_CREDENTIAL=
# WORKER_ID=
# WORKER_NAME=reference-worker
# MAX_CONCURRENCY=1

# --- Web (Vite) ---
# The SPA uses relative /api paths (dev proxy + nginx). No VITE_* vars are
# required today. Placeholders if a future build needs an absolute API URL:
# VITE_API_BASE_URL=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Stripe billing (P-001 / WP-PB-004) ---
# Default false preserves Private Beta (P0): no entitlement checks.
# When true, checkout + webhook routes require the Stripe settings below.
# BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://app.example.com/billing/success
# STRIPE_CHECKOUT_CANCEL_URL=https://app.example.com/billing/cancel

# --- Metrics scrape auth (M-3) ---
# When set, GET /metrics requires Authorization: Bearer <token>.
# Required in production (endpoint returns 401 if unset there).
# METRICS_SCRAPER_TOKEN=

# --- Operations Dashboard deployment metadata ---
# Inject these from the deployment/CI system. If absent the UI explicitly
# shows "Unavailable" instead of placeholder values.
# DEPLOYMENT_GIT_BRANCH=main
# DEPLOYMENT_COMMIT_SHA=
# DEPLOYMENT_AT=2026-08-06T05:00:00Z
# DEPLOYMENT_CI_STATUS=success
# DEPLOYMENT_CI_URL=https://github.com/org/repo/actions/runs/...

# --- Operations Dashboard GitHub live status (optional) ---
# When unset, GitHub widgets report unavailable (never fabricated).
# GITHUB_TOKEN=
# GITHUB_API_TOKEN=
# GITHUB_REPOSITORY=owner/repo

# --- Provider integrations (added as each is implemented; not needed for Phase 1) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=
# CREATOMATE_API_KEY=
# N8N_WEBHOOK_BASE_URL=
# UPLOAD_POST_API_KEY=
