modules = ["python-base-3.13", "nodejs-24"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PostgreSQL"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Ops Preview"

[[workflows.workflow]]
name = "PostgreSQL"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
# --auth-host=scram-sha-256 so the rotated owner/app_runtime passwords are
# actually enforced on TCP connections. Without it initdb writes `trust` for
# host connections and any local process could connect as the table owner,
# bypassing FORCE RLS. --auth-local stays trust so the preview entry script can
# bootstrap the owner password over the unix socket before it is set.
args = "mkdir -p /home/runner/workspace/.pg/data && ([ -f /home/runner/workspace/.pg/data/PG_VERSION ] || initdb -D /home/runner/workspace/.pg/data --auth-local=trust --auth-host=scram-sha-256) && postgres -D /home/runner/workspace/.pg/data -k /tmp -p 5432 -c listen_addresses=127.0.0.1"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Ops Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run_ops_preview_replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[nix]
channel = "stable-25_05"
packages = ["postgresql", "openssl"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
run = ["bash", "scripts/run_ops_preview_replit.sh"]
deploymentTarget = "cloudrun"
